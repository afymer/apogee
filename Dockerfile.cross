FROM rust:bookworm AS builder-arm64

RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y \
        gcc-aarch64-linux-gnu \
        libgphoto2-dev:arm64 \
        libclang-dev \
        pkg-config \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-gnu

ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc

WORKDIR /app

COPY Cargo.cross.toml ./Cargo.toml
COPY Cargo.lock ./
COPY crates/daemon ./crates/daemon
COPY crates/controller ./crates/controller
COPY crates/protocol ./crates/protocol
COPY crates/drivers/gphoto ./crates/drivers/gphoto

RUN cargo build --release --target aarch64-unknown-linux-gnu -p daemon --bin daemon

FROM scratch AS export-arm64
COPY --from=builder-arm64 /app/target/aarch64-unknown-linux-gnu/release/daemon /daemon

# Pi 2, 3 and 4 in 32-bit
FROM rust:bookworm AS builder-armv7

RUN dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y \
        gcc-arm-linux-gnueabihf \
        libgphoto2-dev:armhf \
        libclang-dev \
        pkg-config \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add armv7-unknown-linux-gnueabihf

ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc

WORKDIR /app
COPY Cargo.cross.toml ./Cargo.toml
COPY Cargo.lock ./
COPY crates/daemon ./crates/daemon
COPY crates/controller ./crates/controller
COPY crates/protocol ./crates/protocol
COPY crates/drivers/gphoto ./crates/drivers/gphoto

RUN cargo build --release --target armv7-unknown-linux-gnueabihf -p daemon --bin daemon

FROM scratch AS export-armv7
COPY --from=builder-armv7 /app/target/armv7-unknown-linux-gnueabihf/release/daemon /daemon
